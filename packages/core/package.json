{
  "name": "@reposync/core",
  "version": "2.0.0",
  "description": "GitHub-powered portfolio discovery SDK",
  "repository": {
    "type": "git",
    "url": "https://github.com/PrathamRanka/RepoSync-SDK.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/PrathamRanka/RepoSync-SDK/tree/main/packages/core",
  "bugs": {
    "url": "https://github.com/PrathamRanka/RepoSync-SDK/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "github",
    "portfolio",
    "developer-tools",
    "repository",
    "typescript",
    "sdk",
    "readme-parser",
    "project-discovery"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mdast-util-to-string": "^4.0.0",
    "octokit": "^5.0.5",
    "remark": "^15.0.0",
    "remark-gfm": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
